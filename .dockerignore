# =============================================================================
# Root .dockerignore — applies when building any service from the monorepo root
#
#   docker build -t auth-hub  -f auth-hub/Dockerfile  .
#   docker build -t user-hub  -f user-hub/Dockerfile  .
#   docker build -t know-hub  -f know-hub/Dockerfile  .
# =============================================================================

# Dependencies — reinstalled fresh inside each image
auth-hub/node_modules
user-hub/node_modules
know-hub/node_modules
core/node_modules

# Compiled output — regenerated by the builder stage
auth-hub/dist
user-hub/dist
know-hub/dist

# Infra repo — not needed inside service images
infra/

# Git history
.git
**/.git

# Environment files — never bake secrets into images
**/.env
**/.env.*

# OS / IDE noise
.DS_Store
**/Thumbs.db
**/.vscode
**/.idea

# Logs
**/*.log
**/npm-debug.log*
